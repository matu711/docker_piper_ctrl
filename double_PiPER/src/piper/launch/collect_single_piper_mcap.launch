<launch>
  <arg name="initial_pose_mode_timeout" default="3.0" />
  <arg name="return_leader_with_follower" default="false" />
  <arg name="initial_pose_gripper_tolerance" default="0.005" />
  <arg name="initial_pose_joint_tolerance" default="0.035" />
  <arg name="initial_pose_timeout" default="15.0" />
  <arg name="initial_pose_speed" default="20" />
  <arg name="initial_pose_file" default="$(env HOME)/.config/piper/initial_pose.yaml" />
  <arg name="robot_type" default="piper_single_arm" />
  <arg name="ee_euler_topic" default="/follower/end_pose_euler" />
  <arg name="ee_topic" default="/follower/end_pose" />
  <arg name="action_topic" default="/follower/applied_joint_cmd" />
  <arg name="follower_topic" default="/follower/current_joint_obs" />
  <arg name="leader_topic" default="/leader/joint_grip_pose" />
  <arg name="enable_recording" default="true" />
  <arg name="recorder_launch_prefix" default="xterm -T PiPER-Recorder -e" />
  <arg name="dataset_root" default="$(env HOME)/piper_dataset" />
  <arg name="repo_id" default="local/piper_pickup" />
  <arg name="task" default="Align the bags, grasp them, and lift them up." />
  <arg name="record_fps" default="20" />
  <arg name="sync_tolerance" default="0.03" />
  <arg name="sync_wait" default="0.025" />
  <arg name="max_data_gap" default="1.0" />
  <arg name="enable_cameras" default="true" />
  <arg name="preview" default="true" />
  <arg name="front_camera" default="/dev/video6" />
  <arg name="wrist_camera" default="/dev/video0" />
  <arg name="front_width" default="640" />
  <arg name="front_height" default="480" />
  <arg name="wrist_width" default="640" />
  <arg name="wrist_height" default="480" />
  <arg name="camera_fps" default="30" />
  <arg name="camera_fourcc" default="MJPG" />
  <arg name="camera_backend" default="v4l2" />
  <arg name="camera_open_timeout" default="5.0" />
  <arg name="camera_read_timeout" default="2.0" />
  <arg name="sync_delay" default="0.2" />
  <arg name="camera_target_tolerance" default="0.10" />
  <arg name="camera_sync_tolerance" default="0.03" />
  <arg name="camera_sync_wait" default="0.10" />
  <arg name="max_image_age" default="0.5" />
  <arg name="jpeg_quality" default="95" />
  <arg name="can_follower_port" default="can0" />
  <arg name="can_leader_port" default="can1" />
  <arg name="auto_enable" default="true" />
  <arg name="gripper_val_mutiple" default="1" />
  <group ns="leader">
    <node name="ctrl" pkg="piper" type="control_piper.py" output="screen" args="single leader">
      <param name="can_port" value="$(arg can_leader_port)" />
      <param name="auto_enable" value="$(arg auto_enable)" />
      <param name="gripper_val_mutiple" value="$(arg gripper_val_mutiple)" />
      <param name="gripper_exist" value="true" />
      <remap from="joint_ctrl_single" to="joint_grip_pose" />
      <param name="initial_pose_file" value="$(arg initial_pose_file)" />
      <param name="initial_pose_speed" value="$(arg initial_pose_speed)" />
      <param name="initial_pose_timeout" value="$(arg initial_pose_timeout)" />
      <param name="initial_pose_joint_tolerance" value="$(arg initial_pose_joint_tolerance)" />
      <param name="initial_pose_gripper_tolerance" value="$(arg initial_pose_gripper_tolerance)" />
      <param name="initial_pose_mode_timeout" value="$(arg initial_pose_mode_timeout)" />
    </node>
  </group>
  <group ns="follower">
    <node name="ctrl" pkg="piper" type="control_piper.py" output="screen" args="single follower">
      <param name="can_port" value="$(arg can_follower_port)" />
      <param name="auto_enable" value="$(arg auto_enable)" />
      <param name="gripper_val_mutiple" value="$(arg gripper_val_mutiple)" />
      <param name="gripper_exist" value="true" />
      <remap from="joint_ctrl_single" to="/leader/joint_grip_pose" />
      <remap from="/end_pose_euler" to="/leader/end_pose_euler" />
      <param name="initial_pose_file" value="$(arg initial_pose_file)" />
      <param name="initial_pose_speed" value="$(arg initial_pose_speed)" />
      <param name="initial_pose_timeout" value="$(arg initial_pose_timeout)" />
      <param name="initial_pose_joint_tolerance" value="$(arg initial_pose_joint_tolerance)" />
      <param name="initial_pose_gripper_tolerance" value="$(arg initial_pose_gripper_tolerance)" />
      <param name="return_leader_with_follower" value="$(arg return_leader_with_follower)" />
    </node>
  </group>
  <node if="$(arg enable_recording)" name="single_state_mcap_recorder" pkg="piper" type="record_piper_mcap.py" output="screen" required="false" launch-prefix="$(arg recorder_launch_prefix)">
    <param name="dataset_root" value="$(arg dataset_root)" />
    <param name="repo_id" value="$(arg repo_id)" />
    <param name="task" value="$(arg task)" />
    <param name="fps" value="$(arg record_fps)" />
    <param name="sync_tolerance" value="$(arg sync_tolerance)" />
    <param name="sync_wait" value="$(arg sync_wait)" />
    <param name="max_data_gap" value="$(arg max_data_gap)" />
    <param name="enable_cameras" value="$(arg enable_cameras)" />
    <param name="preview" value="$(arg preview)" />
    <param name="front_camera" value="$(arg front_camera)" />
    <param name="wrist_camera" value="$(arg wrist_camera)" />
    <param name="front_width" value="$(arg front_width)" />
    <param name="front_height" value="$(arg front_height)" />
    <param name="wrist_width" value="$(arg wrist_width)" />
    <param name="wrist_height" value="$(arg wrist_height)" />
    <param name="camera_fps" value="$(arg camera_fps)" />
    <param name="camera_fourcc" value="$(arg camera_fourcc)" />
    <param name="camera_backend" value="$(arg camera_backend)" />
    <param name="camera_open_timeout" value="$(arg camera_open_timeout)" />
    <param name="camera_read_timeout" value="$(arg camera_read_timeout)" />
    <param name="sync_delay" value="$(arg sync_delay)" />
    <param name="camera_target_tolerance" value="$(arg camera_target_tolerance)" />
    <param name="camera_sync_tolerance" value="$(arg camera_sync_tolerance)" />
    <param name="camera_sync_wait" value="$(arg camera_sync_wait)" />
    <param name="max_image_age" value="$(arg max_image_age)" />
    <param name="jpeg_quality" value="$(arg jpeg_quality)" />
    <param name="single_state_topic" value="$(arg follower_topic)" />
    <param name="single_action_topic" value="$(arg action_topic)" />
    <param name="configuration" value="single" />
    <param name="leader_topic" value="$(arg leader_topic)" />
    <param name="ee_topic" value="$(arg ee_topic)" />
    <param name="ee_euler_topic" value="$(arg ee_euler_topic)" />
    <param name="robot_type" value="$(arg robot_type)" />
  </node>
</launch>
